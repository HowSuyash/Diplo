# Copy to .env and fill in. Never commit .env.

# TinyFish: create a key at https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=

# Portal runs use the TinyFish Agent, billed per step (a PNR check is ~6 steps, ~$0.10).
#   1 = all portal runs fake (canned events), 0 = all real,
#   or a comma list of flows to keep fake, e.g. scholarship_status (NSP needs login + OTP).
# Web questions use TinyFish Search + Fetch, which are free, so they run for real whenever
# the key above is set.
MOCK_TINYFISH=1

# Cloud/laptop LLM fallback for intents the rules don't catch.
# Any OpenAI-compatible endpoint works. Leave LLM_BASE_URL empty to disable.
#   Ollama (free, local):  http://localhost:11434/v1   model: llama3.2:3b or qwen2.5:3b
#   Gemini:                https://generativelanguage.googleapis.com/v1beta/openai/   model: gemini-2.5-flash
#   Groq (what we demo):   https://api.groq.com/openai/v1   model: openai/gpt-oss-120b,
#                          key from console.groq.com, and LLM_REASONING_EFFORT=low for ~1 s replies
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b
LLM_API_KEY=ollama
# Reasoning models only (gpt-oss): low | medium | high. Leave empty for other models.
LLM_REASONING_EFFORT=

# 1 = the LLM writes web answers from the fetched pages. 0 (default) = speak the best search
# snippet, completed from its page: nothing is made up. llama3.2:3b invented facts in testing,
# so only turn this on with a strong model.
ANSWER_WITH_LLM=0

# Portal URLs for the web flows. Point the scholarship flow at our mock portal
# for a reliable demo, or the real portal once it is tested.
SCHOLARSHIP_PORTAL_URL=https://scholarships.gov.in/
# indianrail.gov.in has a captcha on PNR enquiry, which an agent can't solve. ConfirmTkt doesn't.
PNR_PORTAL_URL=https://www.confirmtkt.com/pnr-status

# Phone agent: Google ARTEMIS (github.com/google/artemis) on this laptop does any phone task no
# command covers ("dark mode on karo") on the phone connected over USB or wireless debugging.
# Start it on its own port (see README, "Phone agent"), then put its address here. Empty = off.
ARTEMIS_URL=
# flash (~3-5 s per step) or pro (plans and checks its work, 15-40 s per step)
ARTEMIS_PROFILE=flash
# 1 = fake phone-agent runs, to build the app without ARTEMIS or a phone.
MOCK_ARTEMIS=0
# With ARTEMIS on: 1 = it does everything on the phone (calls, messages, settings, any app),
# 0 = the app's instant actions first and ARTEMIS only for the rest.
ARTEMIS_FOR_ALL=1
